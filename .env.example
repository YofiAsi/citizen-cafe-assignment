# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Neon PostgreSQL connection strings — single environment (decision #12):
# one Neon database serves local development, Vercel previews, and production.

# Pooled connection string (Neon PgBouncer endpoint, `-pooler` host).
# Used by the app runtime / Prisma Client. Authenticates as the SELECT-only
# `app_readonly` role (decision #20), not the owner.
DATABASE_URL=

# Direct, unpooled connection string. Used by the Prisma CLI for migrations
# and introspection (`prisma migrate`, `prisma db push`).
DIRECT_URL=
